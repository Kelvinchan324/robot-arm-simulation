<robot name="teaching_arm_not_CAD_conversion">
  <mujoco>
    <compiler discardvisual="false" fusestatic="false" balanceinertia="true" />
  </mujoco>
  <link name="base">
    <inertial>
      <origin xyz="0 0 0.03" />
      <mass value="0.2" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.03" />
      <geometry>
        <box size="0.13 0.13 0.06" />
      </geometry>
      <material name="base">
        <color rgba="0.19 0.25 0.22 1" />
      </material>
    </visual>
  </link>
  <link name="turntable">
    <inertial>
      <origin xyz="0 0 0.025" />
      <mass value="0.2" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.025" />
      <geometry>
        <box size="0.07 0.07 0.065" />
      </geometry>
      <material name="turntable">
        <color rgba="0.7 0.78 0.67 1" />
      </material>
    </visual>
  </link>
  <link name="upper_arm">
    <inertial>
      <origin xyz="0.12 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0.12 0 0" />
      <geometry>
        <box size="0.24 0.045 0.048" />
      </geometry>
      <material name="upper_arm">
        <color rgba="0.76 0.85 0.7 1" />
      </material>
    </visual>
  </link>
  <link name="forearm">
    <inertial>
      <origin xyz="0.10 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0.10 0 0" />
      <geometry>
        <box size="0.20 0.035 0.038" />
      </geometry>
      <material name="forearm">
        <color rgba="0.76 0.85 0.7 1" />
      </material>
    </visual>
  </link>
  <link name="wrist">
    <inertial>
      <origin xyz="0.03 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0.03 0 0" />
      <geometry>
        <box size="0.06 0.045 0.045" />
      </geometry>
      <material name="wrist">
        <color rgba="0.35 0.49 0.38 1" />
      </material>
    </visual>
  </link>
  <link name="gripper">
    <inertial>
      <origin xyz="0.0175 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0.0175 0 0" />
      <geometry>
        <box size="0.035 0.07 0.035" />
      </geometry>
      <material name="gripper">
        <color rgba="0.76 0.85 0.7 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0.06 -0.029 0" />
      <geometry>
        <box size="0.06 0.012 0.023" />
      </geometry>
      <material name="finger-0.029">
        <color rgba="0.28 0.36 0.30 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0.06 0.029 0" />
      <geometry>
        <box size="0.06 0.012 0.023" />
      </geometry>
      <material name="finger0.029">
        <color rgba="0.28 0.36 0.30 1" />
      </material>
    </visual>
  </link>
  <link name="tool">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.005 0.005 0.005" />
      </geometry>
      <material name="tool">
        <color rgba="0.8 0.93 0.37 1" />
      </material>
    </visual>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="base" />
    <child link="turntable" />
    <origin xyz="0 0 0.07" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2" />
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="turntable" />
    <child link="upper_arm" />
    <origin xyz="0 0 0.065" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.7" upper="1.7" effort="10" velocity="2" />
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm" />
    <child link="forearm" />
    <origin xyz="0.24 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.6" upper="2.6" effort="10" velocity="2" />
  </joint>
  <joint name="wrist_pitch" type="revolute">
    <parent link="forearm" />
    <child link="wrist" />
    <origin xyz="0.20 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.8" upper="1.8" effort="10" velocity="2" />
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist" />
    <child link="gripper" />
    <origin xyz="0.06 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2" />
  </joint>
  <joint name="tool_mount" type="fixed">
    <parent link="gripper" />
    <child link="tool" />
    <origin xyz="0.085 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
  </joint>
</robot>